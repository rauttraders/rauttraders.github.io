{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Raut Traders API on Cloudflare Workers (free plan): everything stored in D1 (SQLite). The website is hosted on GitHub Pages.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply raut-traders --local",
    "db:migrate:remote": "wrangler d1 migrations apply raut-traders --remote"
  },
  "dependencies": {
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
