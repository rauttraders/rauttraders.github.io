# --- Hosting the website on GitHub Pages and the API on Cloudflare ---
# Address of the Cloudflare Worker (no trailing slash).
# Leave empty for local development (same address as the site).
# In production: set this as a GitHub Actions repository variable named VITE_API_URL
# Example: https://raut-traders.YOUR-SUBDOMAIN.workers.dev
VITE_API_URL=https://raut-traders.rauttraders.workers.dev
# "/" for a custom domain or <you>.github.io; "/<repository-name>/" for a GitHub Pages project site.
VITE_BASE=/
