# ============================================================
#  Raut Trader's — Root .gitignore
#  Monorepo: frontend/ (React + Vite) · backend/ (Cloudflare Workers / Hono)
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/

# ── Secrets & environment variables ──────────────────────────
# Cloudflare Workers local dev secrets (never commit real secrets)
.dev.vars
# Generic .env files (all variants)
.env
.env.*
# Keep example/template files tracked
!.env.example
!.dev.vars.example
# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
# Cloud service credentials
service-account*.json
credentials.json
secrets.*

# ── Cloudflare Wrangler local state ──────────────────────────
# Local D1 SQLite, KV, R2, cache, and temporary bundles
.wrangler/

# ── Local server data (Node.js fallback server) ──────────────
# Live database, backups, and user-uploaded images — never commit real data
frontend/server/data/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Caches & temp files ───────────────────────────────────────
.cache/
.tmp/
tmp/
*.local
.eslintcache
.oxlintcache

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── IDE & editor ─────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
*.iml
.vs/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
